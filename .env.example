# Copy to .env locally. Do not commit .env.
# Default compose mapping: docker compose -f docker-compose.postgres.yml up -d

DATABASE_URL=postgresql://lsgc:lsgc_dev@127.0.0.1:54329/lsgc
LSGC_TEST_DATABASE_URL=postgresql://lsgc:lsgc_dev@127.0.0.1:54329/lsgc_test

# APPLICATION Google OAuth client (M12.5A). Ordinary users never supply these.
# Placeholders only — never commit real values. Redirect URI must match Google Cloud exactly.
# LSGC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# LSGC_GOOGLE_CLIENT_SECRET=your-client-secret
# LSGC_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/oauth/callback
# LSGC_TOKEN_ENCRYPTION_KEY=generate-with-cryptography.fernet.Fernet.generate_key
# LSGC_ALLOW_PLAINTEXT_OAUTH_TOKENS=false
# LSGC_WEB_ORIGIN=http://127.0.0.1:5173
# LSGC_OAUTH_STATE_TTL_S=600

# Developer fallback only. Not required after a user clicks Connect YouTube.
# If the same exact channel is also OAuth-connected, OAuth wins (no duplicate sync).
# LSGC_YOUTUBE_CHANNEL_ID=UC...
# LSGC_YOUTUBE_CHANNEL_IDS=UC...,UC...
# LSGC_YOUTUBE_API_KEY=
# LSGC_YOUTUBE_ACCESS_TOKEN=
# LSGC_CALIBRATION_DIR=/path/to/calibration
# LSGC_BROADCAST_SYNC_INTERVAL_S=1800

# M11 read-only API (local/development trust; no authentication).
# LSGC_RUN_ORCHESTRATOR=false
# LSGC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LSGC_SSE_HEARTBEAT_S=15
# LSGC_SSE_MAX_QUEUE=32
# LSGC_API_HOST=127.0.0.1
# LSGC_API_PORT=8000

# Live product-path run (same process as M9). Keep the default 1800s API-key
# interval for quota. Lower this only for a short operator validation.
# LSGC_RUN_ORCHESTRATOR=true
# LSGC_BROADCAST_SYNC_INTERVAL_S=30
# LSGC_CALIBRATION_DIR=artifacts/calibration
# LSGC_API_BASE_URL=http://127.0.0.1:8000
